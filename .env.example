NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
ITINERARY_WEBHOOK_URL=
# Allow Team Access to write hero/logo copies into public/brand (also on in development)
ALLOW_PUBLIC_ASSET_WRITE=true

# PocketBase admin (server-only — print/retrieve itinerary APIs)
PB_ADMIN_EMAIL=admin@travelexperiencesgroup.com
PB_ADMIN_PASSWORD=

# Revolut Merchant Checkout
# Prefer REVOLUT_MERCHANT_SECRET_KEY; REVOLUT_SECRET_KEY is a legacy alias
REVOLUT_MERCHANT_SECRET_KEY=sk_...
# REVOLUT_SECRET_KEY=
REVOLUT_API_VERSION=2024-09-01
# sandbox | live | prod  (live and prod both hit production Revolut)
NEXT_PUBLIC_REVOLUT_MODE=sandbox

# Email — SMTP (preferred) + optional Resend fallback
RESEND_API_KEY=re_...
BUSINESS_CONCIERGE_EMAIL=armando@tokiotours.nl
SMTP_HOST=mail.tokiotours.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no_reply@tokiotours.com
SMTP_PASS=
EMAIL_FROM=TOKIOTOURS <no_reply@tokiotours.com>
SMTP_FROM_NAME=TOKIOTOURS
SMTP_FROM_EMAIL=no_reply@tokiotours.com
# Legacy aliases still honoured:
# MAIL_FROM=TOKIOTOURS <no_reply@tokiotours.com>

# Apple Wallet (.pkpass) — local signing with passkit-generator
# Create a Pass Type ID + certificates in Apple Developer, then set:
# APPLE_PASS_TYPE_ID=pass.com.tokiotours.travel
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_WWDR_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# APPLE_PASS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# APPLE_PASS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_PASS_PASSPHRASE=  (if the key is encrypted)
# Or use *_PATH variants pointing at PEM files on the server.
# Optional remote signer fallback (must NOT point at this app):
# APPLE_PASS_SIGNER_URL=
ALLOW_PASS_FALLBACK=true
# Without certs, Add to Apple Wallet opens /pass-preview/:pnr

# Google Wallet — provide a real save URL (no fake JWTs):
# GOOGLE_WALLET_SAVE_URL=https://pay.google.com/gp/v/save/....   (may include {pnr})
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=
