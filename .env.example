NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
ITINERARY_WEBHOOK_URL=
# Allow Team Access to write hero/logo copies into public/brand (also on in development)
ALLOW_PUBLIC_ASSET_WRITE=true

# PocketBase admin (server-only — print/retrieve itinerary APIs)
PB_ADMIN_EMAIL=admin@travelexperiencesgroup.com
PB_ADMIN_PASSWORD=

# Revolut Merchant Checkout
# Prefer REVOLUT_MERCHANT_SECRET_KEY; REVOLUT_SECRET_KEY is a legacy alias
REVOLUT_MERCHANT_SECRET_KEY=sk_...
# REVOLUT_SECRET_KEY=
REVOLUT_API_VERSION=2024-09-01
# sandbox | live | prod  (live and prod both hit production Revolut)
NEXT_PUBLIC_REVOLUT_MODE=sandbox

# Email — itinerary PDF via Resend (client + BCC to team)
RESEND_API_KEY=re_...
# Always BCC armando@tokiotours.nl; optional extra notify address:
BUSINESS_CONCIERGE_EMAIL=armando@tokiotours.nl
# QUOTE_BCC_EMAIL=
# Must be a verified Resend domain sender
MAIL_FROM=TokioTours <noreply@tokiotours.nl>
# Optional SMTP fallback if Resend is unset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
