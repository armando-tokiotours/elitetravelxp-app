# Copy to .env on the VPS:  cp .env.production.example .env
PUBLIC_URL=https://tokiotours-app.com
NEXT_PUBLIC_POCKETBASE_URL=https://tokiotours-app.com
NEXT_PUBLIC_SITE_URL=https://tokiotours-app.com
NEXT_PUBLIC_APP_URL=https://tokiotours-app.com
PB_ADMIN_EMAIL=admin@tokiotours-app.com
PB_ADMIN_PASSWORD=change-this-strong-password
# Used by server routes inside Docker (itinerary save / retrieve / email)
POCKETBASE_INTERNAL_URL=http://pocketbase:8090
CERTBOT_EMAIL=admin@tokiotours-app.com
ITINERARY_WEBHOOK_URL=

# Revolut Merchant Checkout
REVOLUT_MERCHANT_SECRET_KEY=sk_...
# REVOLUT_SECRET_KEY=
REVOLUT_API_VERSION=2024-09-01
NEXT_PUBLIC_REVOLUT_MODE=live

# Email — itinerary PDF via Resend (client + BCC armando@tokiotours.nl)
RESEND_API_KEY=re_...
BUSINESS_CONCIERGE_EMAIL=armando@tokiotours.nl
MAIL_FROM=TOKIOTOURS <noreply@tokiotours.nl>
SMTP_HOST=mail.tokiotours.com
SMTP_PORT=465
SMTP_USER=no_reply@tokiotours.com
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM_NAME=Tokiotours Concierge
SMTP_FROM_EMAIL=no_reply@tokiotours.com
ALLOW_PASS_FALLBACK=true
# APPLE_PASS_SIGNER_URL=
