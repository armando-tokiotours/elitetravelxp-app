# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PocketBase runtime data
backend/pb_data/
backend/pocketbase
backend/CHANGELOG.md
backend/LICENSE.md
scripts/.seed-tmp/
backend/.pb_backups/

# Local VPS media (ticket PDFs, catalog, comms, profiles)
/public/uploads/tickets/**
!/public/uploads/tickets/.gitkeep
/public/uploads/vouchers/**
!/public/uploads/vouchers/.gitkeep
/public/uploads/comms/**
!/public/uploads/comms/.gitkeep
/public/uploads/catalog/**
!/public/uploads/catalog/.gitkeep
/public/uploads/profiles/**
!/public/uploads/profiles/.gitkeep
/public/uploads/general/**
!/public/uploads/general/.gitkeep
/data/ticket-uploads/

# Local toolchain binaries / scratch
.tools/
